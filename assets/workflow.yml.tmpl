# Written by searchtrace {{version}}. Runs daily and saves your search history to this PRIVATE repo.
#
# Three jobs, so the code that sees your secrets never holds a token that can push:
#   guard    stops at once if this repo is public.
#   collect  builds searchtrace {{version}} from one fixed commit (its lockfile pins every
#            dependency), runs it with your secrets, and hands the new files on. Read-only.
#   save     commits those files. It holds the push token and runs no downloaded code.
# Every action is pinned to a full commit SHA. To upgrade, run a newer searchtrace's `setup --github`.
name: searchtrace
on:
  schedule:
    - cron: "17 6 * * *"          # 06:17 UTC daily, away from the busy top of the hour
  workflow_dispatch: {}
permissions: {}
concurrency:
  group: searchtrace
  cancel-in-progress: false
jobs:
  guard:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
    steps:
      - name: Refuse to run in a public repo
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
        run: |
          if [ "$(gh api "repos/$REPO" --jq .private)" != "true" ]; then
            echo "::error::This repo is public. Search Console data is private business data. Make the repo private, then re-run."
            exit 2
          fi

  collect:
    needs: guard
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    outputs:
      base: ${{ steps.base.outputs.sha }}
    steps:
      # The branch tip, so a queued run or a re-run starts from the latest saved data. No push token.
      - name: Check out your data
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.ref }}
          persist-credentials: false
      # Recorded before any searchtrace code runs; the save job replays the new files on top of it.
      - name: Note the commit this run starts from
        id: base
        run: echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
      - name: Check out searchtrace {{version}}
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: JhontyBarreto/searchtrace
          ref: "{{ref}}"
          path: .searchtrace-tool
          persist-credentials: false
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "22"
          package-manager-cache: false
      - name: Build searchtrace from its lockfile
        working-directory: .searchtrace-tool
        run: |
          npm ci --ignore-scripts --no-audit --no-fund
          npm run build
      - name: Restore the search index
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: searchtrace-data/state/index.sqlite
          key: searchtrace-index-{{version}}-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: searchtrace-index-{{version}}-
      - name: Run searchtrace
        run: node .searchtrace-tool/dist/bin.js run --ci --dir searchtrace-data
        env:
          SEARCHTRACE_GOOGLE_KEY: ${{ secrets.SEARCHTRACE_GOOGLE_KEY }}
          DATAFORSEO_LOGIN: ${{ secrets.DATAFORSEO_LOGIN }}
          DATAFORSEO_PASSWORD: ${{ secrets.DATAFORSEO_PASSWORD }}
      - name: Keep the search index for the next run
        if: always()
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: searchtrace-data/state/index.sqlite
          key: searchtrace-index-{{version}}-${{ github.run_id }}-${{ github.run_attempt }}
      - name: Pack the new files for the save job
        if: always()
        run: |
          git ls-files --modified --others --exclude-standard -z -- searchtrace-data > "$RUNNER_TEMP/changed.list"
          tar --null -T "$RUNNER_TEMP/changed.list" -cf "$RUNNER_TEMP/searchtrace-changes.tar"
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        if: always()
        with:
          name: searchtrace-changes
          path: ${{ runner.temp }}/searchtrace-changes.tar
          retention-days: 1
          if-no-files-found: ignore
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        if: always()
        with:
          name: searchtrace-report
          path: searchtrace-data/reports/latest.html
          retention-days: 30
          if-no-files-found: ignore

  save:
    needs: collect
    # A run that stopped part way (exit 3 or 4) still saves what it collected.
    if: always() && needs.collect.result != 'skipped'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      # The commit the run started from: the new files are committed on top of it, then rebased
      # onto the branch tip, so anything pushed meanwhile (a note, say) is merged, not overwritten.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ needs.collect.outputs.base || github.ref }}
      - name: Fetch the new files
        id: changes
        continue-on-error: true
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: searchtrace-changes
          path: ${{ runner.temp }}/searchtrace-changes
      - name: Save history
        if: steps.changes.outcome == 'success'
        run: |
          tar -xf "$RUNNER_TEMP/searchtrace-changes/searchtrace-changes.tar" --no-same-owner --no-same-permissions
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          cd searchtrace-data
          for p in config.json meta.json .gitignore .gitattributes gsc google crawl inspect serp findings ledger annotations.ndjson reports graphify-out/graph.json graphify-out/searchtrace.meta.json; do
            if [ -e "$p" ]; then git add -- "$p"; fi
          done
          if git diff --cached --quiet; then echo "Nothing new to save."; exit 0; fi
          git commit -m "searchtrace: data through $(jq -r .data_through reports/findings.json 2>/dev/null || date -u +%F)"
          for i in 1 2 3; do
            if git fetch --quiet --no-tags origin "$GITHUB_REF_NAME" && git rebase --quiet FETCH_HEAD; then
              git push origin "HEAD:refs/heads/$GITHUB_REF_NAME" && exit 0
            else
              git rebase --abort || true
            fi
            sleep 5
          done
          branch="searchtrace-unsaved-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          if git push origin "HEAD:refs/heads/$branch"; then
            echo "::error::Couldn't save to $GITHUB_REF_NAME. This run's data, including its spend records, is on the branch $branch. Merge it, then delete the branch."
          else
            echo "::error::Couldn't save this run's data. The spend records are in the searchtrace-changes artifact for 1 day."
          fi
          exit 1
