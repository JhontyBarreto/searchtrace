{
  "name": "searchtrace",
  "version": "0.1.0",
  "description": "Honest answers to \"why did my Google traffic change?\" from your own Search Console data, with the evidence.",
  "license": "MIT",
  "author": "Jhonty Barreto",
  "homepage": "https://github.com/JhontyBarreto/searchtrace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JhontyBarreto/searchtrace.git"
  },
  "bugs": {
    "url": "https://github.com/JhontyBarreto/searchtrace/issues"
  },
  "keywords": [
    "seo",
    "google-search-console",
    "search-console",
    "ai-overviews",
    "traffic-drop",
    "causal-inference",
    "graphify",
    "knowledge-graph",
    "cli",
    "dataforseo",
    "core-update",
    "google-search-console-api",
    "seo-tools"
  ],
  "type": "module",
  "bin": {
    "searchtrace": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --sourceMap false && node scripts/build-info.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
